# Copy to .env.local and fill in from Supabase: the "Connect" button at the top of the project,
# or Project Settings → Data API (URL) and Project Settings → API Keys (key).
# Leave both empty to use the built-in film list in src/components/aqua/videos.ts.
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or legacy anon key. Never the secret / service_role key.
SUPABASE_ANON_KEY=
